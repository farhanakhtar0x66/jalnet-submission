# Server values: actual outputs only. Never commit a populated .env.
# Profile and region are the user's intended target, not evidence of access.
AWS_PROFILE=jalnet
AWS_REGION=ap-south-1
EVENTS_TABLE=
REPORTS_TABLE=
USERS_TABLE=
DROPLET_LEDGER_TABLE=
EVIDENCE_BUCKET=
MEDIA_QUEUE_URL=
MEDIA_QUEUE_ARN=
BEDROCK_MODEL_ID=
COGNITO_ISSUER=
COGNITO_CLIENT_ID=

# Private deployment/smoke inputs are NOT environment defaults. See
# docs/AWS_DEPLOYMENT_RUNBOOK.md and scripts/aws-safety.ts for the strict
# private JSON schema: expectedAccountId, expectedRoleArn, exact model/profile
# and permitted InvokeModel ARNs, map key name/signing certificate, optional
# approved bootstrap execution policy. There is no deployable example manifest.

# Expo reads apps/mobile/.env. This section intentionally selects LOCAL/DEMO.
# AWS mode needs ALL live fields below filled from actual outputs/restricted key.
# The validator rejects the local HTTP URL when mode=aws.
EXPO_PUBLIC_PROVIDER_MODE=local-demo
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8787
EXPO_PUBLIC_AWS_REGION=ap-south-1
EXPO_PUBLIC_COGNITO_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_COGNITO_DOMAIN=
EXPO_PUBLIC_LOCATION_MAP_KEY=
EXPO_PUBLIC_LOCATION_MAP_RESOURCE_ARN=
EXPO_PUBLIC_ANDROID_CERT_SHA1=

# No credentials, static keys, client secrets or bearer tokens belong here.
# Deferred features have no implementation or configuration in this P0 cutover.
